{
  "name": "shadowdraw-desktop",
  "productName": "ShadowDraw",
  "version": "1.0.2",
  "description": "ShadowDraw — Magic Hands Studio. Desktop (Windows/macOS/Linux) build of the web app. Works fully offline.",
  "author": "Shadow Creative Studio",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "sync": "node sync.js",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --win nsis portable --x64",
    "dist:mac": "npm run sync && electron-builder --mac dmg",
    "dist:linux": "npm run sync && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shadowcreativestudio.shadowdraw",
    "productName": "ShadowDraw",
    "copyright": "© 2026 Shadow Creative Studio",
    "asar": false,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["app/**", "electron/**", "package.json"],
    "win": { "icon": "build/icon.ico", "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShadowDraw",
      "artifactName": "ShadowDraw-Setup-${version}.exe"
    },
    "portable": { "artifactName": "ShadowDraw-Portable-${version}.exe" },
    "mac": { "icon": "app/icons/icon-512.png", "category": "public.app-category.kids", "extendInfo": { "NSCameraUsageDescription": "ShadowDraw uses the camera to follow your hands. Nothing is uploaded." } },
    "linux": { "icon": "app/icons/icon-512.png", "category": "Education" }
  }
}
